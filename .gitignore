# =====================================================
# Git Ignore Configuration
# =====================================================

# ----- SECRETS & ENVIRONMENT VARIABLES (CRITICAL) -----
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.secret

# ----- PYTHON -----
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Environments
.env/
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# ----- NODE / JAVASCRIPT / NEXT.JS -----
node_modules/
app/web/node_modules/
.next/
app/web/.next/
out/
app/web/out/
build/
dist/
.pnp
.pnp.js

# Next.js build cache & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----- AUDIO / ARTIFACTS / SCRATCH -----
*.wav
*.mp3
*.pcm
scratch/
scratch_tts_test.wav

# ----- OS & IDE -----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
